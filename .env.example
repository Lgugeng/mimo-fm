# MiMo API
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Spotify (optional - for playlist import)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback

# Database
DATABASE_URL=sqlite+aiosqlite:///./mimo_fm.db

# Security (required - generate random strings)
SECRET_KEY=<generate-random-string>  # For session signing
ENCRYPTION_KEY=<generate-fernet-key>   # For token encryption (use: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# App
DEBUG=true
